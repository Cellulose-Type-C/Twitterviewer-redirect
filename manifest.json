{
  "manifest_version": 2,
  "name": "Twitterviewer redirect",
  "version": "1.0.1",
  "description": "Opens X/Twitter posts, profiles, and hashtags in TwitterViewer.net automatically.",
  "homepage_url": "https://twitterviewer.net",
  "browser_specific_settings": {
    "gecko": {
      "id": "x-twitterviewer-redirect@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*"
  ],
  "background": {
    "scripts": ["lib/redirect.js", "background.js"],
    "persistent": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
